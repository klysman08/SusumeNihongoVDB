---
import Layout from '../../layouts/Layout.astro';
import BookHeader from '../../components/BookHeader.tsx';
import BookSearch from '../../components/BookSearch.tsx';
import SectionBackgroundImage from '../../components/SectionBackgroundImage.tsx';
import {
  ArrowRight,
  BookOpen,
  ChevronDown,
  Map,
  Sparkles,
  Trophy,
} from 'lucide-react';
import { getLocaleFromPath, getLocalizedPath, HTML_LANG, type SiteLocale } from '../../i18n/config';
import { getBookIndexText } from '../../i18n/bookIndexCatalogs';
import { getLocalizedBookChapterFrontmatter } from '../../i18n/book-content/loader';
import { getCollection } from 'astro:content';

const locale = (Astro.props.locale as SiteLocale | undefined) ?? getLocaleFromPath(Astro.url.pathname);
const t = (
  key: Parameters<typeof getBookIndexText>[1],
  values: Parameters<typeof getBookIndexText>[2] = {},
) => getBookIndexText(locale, key, values);

type Chapter = {
  title: string;
  cleanTitle: string;
  chapter: number;
  displayChapter: string;
  url: string;
  slug: string;
  description: string;
  level: 'N5' | 'N4' | 'N3';
  unit?: number;
  unitTitle: string;
};

const bookPages = await getCollection('book');
const chapters = bookPages
  .sort((a, b) => a.data.chapter - b.data.chapter)
  .map((entry): Chapter => {
    const chapter = entry.data.chapter;
    const localizedFrontmatter = getLocalizedBookChapterFrontmatter(locale, entry.id);
    const title = localizedFrontmatter?.title || entry.data.title || `Chapter ${chapter}`;
    const url = getLocalizedPath(`/book/${entry.id}`, locale);

    return {
      title,
      cleanTitle: title.replace(/^(?:Chapter|Capítulo|第)\s*\d+\s*(?:章)?\s*[—–-]\s*/, ''),
      chapter,
      displayChapter: String(chapter).padStart(2, '0'),
      url,
      slug: entry.id,
      description: localizedFrontmatter?.description || entry.data.description,
      level: entry.data.level,
      unit: entry.data.unit,
      unitTitle: entry.data.unitTitle || '',
    };
  });

const levelData = [
  {
    id: 'n5',
    level: 'N5' as const,
    eyebrow: t('beginner'),
    title: t('foundationsTitle'),
    japanese: '基礎',
    description: t('foundationsDescription'),
    chapters: chapters.filter((chapter) => chapter.level === 'N5'),
  },
  {
    id: 'n4',
    level: 'N4' as const,
    eyebrow: t('preIntermediate'),
    title: t('everydayTitle'),
    japanese: '成長',
    description: t('everydayDescription'),
    chapters: chapters.filter((chapter) => chapter.level === 'N4'),
  },
  {
    id: 'n3',
    level: 'N3' as const,
    eyebrow: t('intermediate'),
    title: t('nuanceTitle'),
    japanese: '前進',
    description: t('nuanceDescription'),
    chapters: chapters.filter((chapter) => chapter.level === 'N3'),
  },
];

const n3Units = Array.from(
  new Set(levelData[2].chapters.map((chapter) => chapter.unit).filter((unit): unit is number => Boolean(unit))),
).map((unit) => ({
  unit,
  title: levelData[2].chapters.find((chapter) => chapter.unit === unit)?.unitTitle || '',
  chapters: levelData[2].chapters.filter((chapter) => chapter.unit === unit),
}));

const totalChapters = chapters.length;
const firstChapter = chapters[0];
const bookPath = getLocalizedPath('/book', locale);
const bookJsonLd = {
  '@graph': [
    {
      '@type': ['CollectionPage', 'Course'],
      '@id': new URL(`${bookPath}/#course`, 'https://susumenihongo.app').href,
      url: new URL(`${bookPath}/`, 'https://susumenihongo.app').href,
      name: t('seoTitle'),
      description: t('jsonLdDescription'),
      provider: { '@id': 'https://susumenihongo.app/#organization' },
      inLanguage: HTML_LANG[locale],
      educationalLevel: ['JLPT N5', 'JLPT N4', 'JLPT N3'],
      hasPart: chapters.map((chapter) => ({
        '@type': 'LearningResource',
        position: chapter.chapter,
        name: chapter.cleanTitle,
        url: new URL(chapter.url, 'https://susumenihongo.app').href,
        educationalLevel: `JLPT ${chapter.level}`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('home'), item: new URL(getLocalizedPath('/', locale), 'https://susumenihongo.app').href },
        { '@type': 'ListItem', position: 2, name: t('heroTitle'), item: new URL(`${bookPath}/`, 'https://susumenihongo.app').href },
      ],
    },
  ],
};
---

<Layout
  title={t('seoTitle')}
  description={t('seoDescription', { count: totalChapters })}
  image="/susume-banner.png"
  jsonLd={bookJsonLd}
  locale={locale}
>
  <div data-page-shell="book" style="view-transition-name: page-book;" class="min-h-screen bg-zinc-50 dark:bg-zinc-950">
    <header class="site-glass-header">
      <div class="mx-auto max-w-7xl px-3 py-2 sm:px-4 sm:py-3">
        <BookHeader
          client:only="react"
          currentPath={getLocalizedPath('/book', locale)}
          locale={locale}
          deferUntilHydrated={false}
          transition:persist={`book-site-header-${locale}`}
        />
      </div>
    </header>

    <section class="relative min-h-[60vh] overflow-hidden sm:min-h-[70vh] lg:min-h-[80vh]">
      <div class="absolute inset-0 bg-gradient-to-br from-ai-700 via-ai-800 to-ai-950 dark:from-ai-900 dark:via-ai-950 dark:to-zinc-950" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-8 top-1/2 -translate-y-1/2 select-none text-[40vw] font-black leading-none text-white/[0.04] sm:text-[20vw]" aria-hidden="true">本</div>
      <SectionBackgroundImage
        image="susume-banner.png"
        opacity={0.05}
        invertInDark={false}
        zIndex={0}
        fit="cover"
        position="top center"
        wrapper={{ inset: 0 }}
        imageSize={{ width: '100%', height: '100%' }}
      />
      <div class="absolute -left-32 top-0 size-96 rounded-full bg-ai-400/20 blur-[100px]" aria-hidden="true"></div>
      <div class="absolute bottom-0 right-0 size-120 rounded-full bg-sakura-400/15 blur-[80px]" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
        <nav aria-label={t('breadcrumbLabel')} class="mb-8 text-sm">
          <a href={getLocalizedPath('/', locale)} class="rounded-md text-ai-200 transition-colors hover:text-white focus:outline-none focus:ring-2 focus:ring-sakura-300">{t('home')}</a>
          <span class="mx-2 text-ai-300/60" aria-hidden="true">/</span>
          <span class="text-ai-100" aria-current="page">{t('studyBook')}</span>
        </nav>

        <div class="flex items-start gap-5 sm:gap-8">
          <div class="flex size-16 shrink-0 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/30 backdrop-blur-sm sm:size-20">
            <BookOpen size={32} className="text-white sm:size-10" aria-hidden="true" />
          </div>

          <div class="min-w-0 max-w-3xl">
            <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-widest text-ai-100">
              <Sparkles size={12} aria-hidden="true" />
              {t('chapterBadge', { count: totalChapters })}
            </div>
            <h1 class="mb-3 text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl">{t('heroTitle')}</h1>
            <p class="max-w-2xl text-base leading-relaxed text-ai-100 sm:text-lg">
              {t('heroIntro')}
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-ai-200 sm:gap-6">
              <span class="flex items-center gap-2"><BookOpen size={16} className="opacity-70" aria-hidden="true" />{t('chaptersCount', { count: totalChapters })}</span>
              <span class="hidden h-4 w-px bg-ai-400/40 sm:block" aria-hidden="true"></span>
              <span class="flex items-center gap-2"><Trophy size={16} className="opacity-70" aria-hidden="true" />{t('trackProgress')}</span>
              <span class="hidden h-4 w-px bg-ai-400/40 sm:block" aria-hidden="true"></span>
              <span class="flex items-center gap-2"><Sparkles size={16} className="opacity-70" aria-hidden="true" />{t('aiIntegration')}</span>
            </div>

            <div class="mt-7 max-w-2xl" aria-labelledby="progress-title">
              <div class="mb-2 flex items-end justify-between gap-4 text-sm text-ai-200">
                <div>
                  <span id="progress-title">{t('readingProgress')}</span>
                  <span id="progress-count" class="mt-0.5 block text-xs text-ai-300">{t('progressComplete', { completed: 0, total: totalChapters })}</span>
                </div>
                <span id="progress-percent" class="font-bold text-white">0%</span>
              </div>
              <div id="book-progress" class="h-2.5 overflow-hidden rounded-full bg-ai-950/70 ring-1 ring-white/10" role="progressbar" aria-label={t('bookCompletion')} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="progress-fill" class="h-full rounded-full bg-sakura-500 transition-[width] duration-700 motion-reduce:transition-none" style="width: 0%"></div>
              </div>
              <a id="continue-reading-link" href={firstChapter?.url || '#levels'} class="mt-5 inline-flex items-center gap-2 rounded-xl bg-sakura-600 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-sakura-500/20 transition-colors hover:bg-sakura-700 focus:outline-none focus:ring-2 focus:ring-sakura-300 focus:ring-offset-2 focus:ring-offset-ai-950">
                <span id="continue-reading-text">{t('startChapter', { number: '01' })}</span>
                <ArrowRight size={16} aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14">
      <section id="levels" aria-labelledby="levels-title" class="scroll-mt-24">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-ai-600 dark:text-ai-400">{t('courseMap')}</p>
            <h2 id="levels-title" class="mt-2 text-2xl font-black tracking-tight text-zinc-950 dark:text-white sm:text-3xl">{t('chooseLevel')}</h2>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-zinc-600 dark:text-zinc-400">{t('levelPrompt')}</p>
          </div>
          <a href="#chapters" class="inline-flex items-center gap-2 text-sm font-bold text-ai-600 hover:text-ai-700 dark:text-ai-400 dark:hover:text-ai-300">
            {t('browseChapters')} <ChevronDown size={16} aria-hidden="true" />
          </a>
        </div>

        <div class="mt-7 grid gap-4 lg:grid-cols-3">
          {levelData.map((item) => (
            <a
              href={`#${item.id}`}
              class:list={[
                'group relative overflow-hidden rounded-2xl border bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 dark:bg-zinc-900/50 dark:focus:ring-offset-zinc-950 sm:p-6',
                item.level === 'N5' && 'border-sakura-200 hover:border-sakura-400 focus:ring-sakura-500 dark:border-sakura-900/70',
                item.level === 'N4' && 'border-fuji-200 hover:border-fuji-400 focus:ring-fuji-500 dark:border-fuji-900/70',
                item.level === 'N3' && 'border-kon-200 hover:border-kon-400 focus:ring-kon-500 dark:border-kon-900/70',
              ]}
            >
              <div class:list={['absolute inset-x-0 top-0 h-1', item.level === 'N5' && 'bg-sakura-500', item.level === 'N4' && 'bg-fuji-500', item.level === 'N3' && 'bg-kon-500']}></div>
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <span class:list={['inline-flex size-12 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg', item.level === 'N5' && 'bg-sakura-600 shadow-sakura-500/20', item.level === 'N4' && 'bg-fuji-600 shadow-fuji-500/20', item.level === 'N3' && 'bg-kon-600 shadow-kon-500/20']}>{item.level}</span>
                  <div>
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">{item.eyebrow}</p>
                    <h3 class="mt-1 font-bold text-zinc-950 dark:text-white">{item.title}</h3>
                  </div>
                </div>
                <span class="font-serif text-2xl font-black text-zinc-200 dark:text-zinc-700" lang="ja">{item.japanese}</span>
              </div>
              <p class="mt-5 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{item.description}</p>
              <div class="mt-5 flex items-center justify-between border-t border-zinc-100 pt-4 dark:border-zinc-800">
                <span class="text-xs font-bold text-zinc-500 dark:text-zinc-400">{t('chaptersRange', { count: item.chapters.length, start: item.chapters[0]?.displayChapter ?? '', end: item.chapters.at(-1)?.displayChapter ?? '' })}</span>
                <ArrowRight size={17} className="text-zinc-400 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </div>
            </a>
          ))}
        </div>
      </section>

      <section id="chapters" aria-labelledby="chapters-title" class="mt-14 scroll-mt-24 sm:mt-20">
        <div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10">
          <aside class="lg:sticky lg:top-6 lg:self-start">
            <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/50">
              <div class="flex items-center gap-2 px-1">
                <Map size={18} className="text-ai-600 dark:text-ai-400" aria-hidden="true" />
                <h2 id="chapters-title" class="font-bold text-zinc-950 dark:text-white">{t('allChapters')}</h2>
              </div>
              <nav aria-label={t('bookLevels')} class="mt-4 grid grid-cols-3 gap-2 lg:grid-cols-1">
                {levelData.map((item) => (
                  <a href={`#${item.id}`} class="group flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-semibold text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white">
                    <span>{item.level}</span>
                    <span class="hidden text-xs font-medium text-zinc-400 lg:inline">{item.chapters.length}</span>
                  </a>
                ))}
              </nav>
              <div class="mt-4 border-t border-zinc-100 pt-4 dark:border-zinc-800">
                <BookSearch client:load placement="sidebar" />
                <p class="mt-2 px-1 text-[0.7rem] leading-5 text-zinc-400">{t('searchHint')}</p>
              </div>
            </div>
          </aside>

          <div class="min-w-0 space-y-16">
            {levelData.map((item) => (
              <section id={item.id} class="scroll-mt-24" data-level-section={item.level}>
                <div class="mb-6 flex flex-col gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800 sm:flex-row sm:items-end sm:justify-between">
                  <div class="flex items-center gap-4">
                    <span class:list={['inline-flex size-12 shrink-0 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg', item.level === 'N5' && 'bg-sakura-600 shadow-sakura-500/20', item.level === 'N4' && 'bg-fuji-600 shadow-fuji-500/20', item.level === 'N3' && 'bg-kon-600 shadow-kon-500/20']}>{item.level}</span>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-[0.15em] text-zinc-500 dark:text-zinc-400">{t('levelHeading', { eyebrow: item.eyebrow, start: item.chapters[0]?.displayChapter ?? '', end: item.chapters.at(-1)?.displayChapter ?? '' })}</p>
                      <h2 class="mt-1 text-xl font-black text-zinc-950 dark:text-white sm:text-2xl">{item.title}</h2>
                    </div>
                  </div>
                  <div class="w-full sm:w-48">
                    <div class="mb-1.5 flex justify-between text-[0.68rem] font-semibold text-zinc-500 dark:text-zinc-400">
                      <span>{t('levelProgress')}</span>
                      <span data-level-count={item.level}>0/{item.chapters.length}</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
                      <div data-level-fill={item.level} class:list={['h-full w-0 rounded-full transition-[width] duration-700 motion-reduce:transition-none', item.level === 'N5' && 'bg-sakura-500', item.level === 'N4' && 'bg-fuji-500', item.level === 'N3' && 'bg-kon-500']}></div>
                    </div>
                  </div>
                </div>

                {item.level !== 'N3' ? (
                  <div class="grid gap-3 sm:grid-cols-2">
                    {item.chapters.map((chapter) => (
                      <a href={chapter.url} data-astro-prefetch="tap" data-chapter-card data-chapter-slug={chapter.slug} data-chapter-level={chapter.level} class:list={['group flex min-h-32 gap-4 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 dark:border-zinc-800 dark:bg-zinc-900/50 dark:focus:ring-offset-zinc-950 sm:p-5', item.level === 'N5' && 'hover:border-sakura-300 focus:ring-sakura-500 dark:hover:border-sakura-800', item.level === 'N4' && 'hover:border-fuji-300 focus:ring-fuji-500 dark:hover:border-fuji-800']}>
                        <span class:list={['chapter-badge inline-flex size-11 shrink-0 items-center justify-center rounded-xl text-sm font-black text-white', item.level === 'N5' && 'bg-sakura-600', item.level === 'N4' && 'bg-fuji-600']}>{chapter.displayChapter}</span>
                        <span class="flex min-w-0 flex-1 flex-col">
                          <span lang="en" class:list={['font-bold leading-snug text-zinc-950 transition-colors dark:text-white', item.level === 'N5' && 'group-hover:text-sakura-700 dark:group-hover:text-sakura-300', item.level === 'N4' && 'group-hover:text-fuji-700 dark:group-hover:text-fuji-300']}>{chapter.cleanTitle}</span>
                          <span lang="en" class="mt-2 line-clamp-2 text-xs leading-5 text-zinc-500 dark:text-zinc-400">{chapter.description}</span>
                          <span class="mt-auto inline-flex items-center gap-1 pt-3 text-xs font-bold text-zinc-400">{t('readChapter')} <ArrowRight size={13} className="transition-transform group-hover:translate-x-0.5" aria-hidden="true" /></span>
                        </span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <div class="space-y-8">
                    {n3Units.map((unit) => (
                      <section aria-labelledby={`unit-${unit.unit}-title`}>
                        <div class="mb-3 flex items-center gap-3">
                          <span class="inline-flex size-8 items-center justify-center rounded-xl bg-kon-100 text-xs font-black text-kon-700 dark:bg-kon-500/15 dark:text-kon-300">{unit.unit}</span>
                          <div>
                            <h3 id={`unit-${unit.unit}-title`} class="text-sm font-bold text-zinc-950 dark:text-white">
                              {t('unitHeading', { number: unit.unit, title: '' })} <span lang="en">{unit.title}</span>
                            </h3>
                            <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">{t('chapterRangeHeading', { start: unit.chapters[0]?.displayChapter ?? '', end: unit.chapters.at(-1)?.displayChapter ?? '' })}</p>
                          </div>
                        </div>
                        <div class="grid gap-3 sm:grid-cols-2">
                          {unit.chapters.map((chapter) => (
                            <a href={chapter.url} data-astro-prefetch="tap" data-chapter-card data-chapter-slug={chapter.slug} data-chapter-level={chapter.level} class="group flex min-h-32 gap-4 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-kon-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-kon-500 focus:ring-offset-2 dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-kon-800 dark:focus:ring-offset-zinc-950 sm:p-5">
                              <span class="chapter-badge inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-kon-600 text-sm font-black text-white">{chapter.displayChapter}</span>
                              <span class="flex min-w-0 flex-1 flex-col">
                                <span lang="en" class="font-bold leading-snug text-zinc-950 transition-colors group-hover:text-kon-700 dark:text-white dark:group-hover:text-kon-300">{chapter.cleanTitle}</span>
                                <span lang="en" class="mt-2 line-clamp-2 text-xs leading-5 text-zinc-500 dark:text-zinc-400">{chapter.description}</span>
                                <span class="mt-auto inline-flex items-center gap-1 pt-3 text-xs font-bold text-zinc-400">{t('readChapter')} <ArrowRight size={13} className="transition-transform group-hover:translate-x-0.5" aria-hidden="true" /></span>
                              </span>
                            </a>
                          ))}
                        </div>
                      </section>
                    ))}
                  </div>
                )}
              </section>
            ))}
          </div>
        </div>
      </section>
    </main>
  </div>

  <script
    is:inline
    define:vars={{
      progressCompleteTemplate: t('progressComplete'),
      completedLabel: t('completed'),
      startChapterTemplate: t('startChapter'),
      continueChapterTemplate: t('continueChapter'),
      reviewChapterTemplate: t('reviewChapter'),
    }}
  >
    (function () {
      const STORAGE_KEY = 'japanese-teacher-book-progress';

      function setupBookIndex() {
        const cards = Array.from(document.querySelectorAll('[data-chapter-card]'));
        if (!cards.length) return;

        try {
          const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          const completedSlugs = new Set(saved.filter((item) => item && item.completed).map((item) => item.chapterSlug));
          const completedCards = cards.filter((card) => completedSlugs.has(card.dataset.chapterSlug));
          const percentage = Math.round((completedCards.length / cards.length) * 100);

          const fill = document.getElementById('progress-fill');
          const count = document.getElementById('progress-count');
          const percent = document.getElementById('progress-percent');
          const progress = document.getElementById('book-progress');
          if (fill) fill.style.width = percentage + '%';
          if (count) count.textContent = progressCompleteTemplate
            .replace('{completed}', String(completedCards.length))
            .replace('{total}', String(cards.length));
          if (percent) percent.textContent = percentage + '%';
          if (progress) progress.setAttribute('aria-valuenow', String(percentage));

          cards.forEach((card) => {
            if (!completedSlugs.has(card.dataset.chapterSlug)) return;
            card.dataset.completed = 'true';
            const badge = card.querySelector('.chapter-badge');
            if (badge) {
              badge.classList.add('bg-green-600');
              badge.innerHTML = '<svg aria-label="' + completedLabel + '" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"></path></svg>';
            }
          });

          ['N5', 'N4', 'N3'].forEach((level) => {
            const levelCards = cards.filter((card) => card.dataset.chapterLevel === level);
            const levelCompleted = levelCards.filter((card) => completedSlugs.has(card.dataset.chapterSlug)).length;
            const levelPercentage = levelCards.length ? Math.round((levelCompleted / levelCards.length) * 100) : 0;
            const levelCount = document.querySelector(`[data-level-count="${level}"]`);
            const levelFill = document.querySelector(`[data-level-fill="${level}"]`);
            if (levelCount) levelCount.textContent = levelCompleted + '/' + levelCards.length;
            if (levelFill) levelFill.style.width = levelPercentage + '%';
          });

          const nextChapter = cards.find((card) => !completedSlugs.has(card.dataset.chapterSlug)) || cards[0];
          const continueLink = document.getElementById('continue-reading-link');
          const continueText = document.getElementById('continue-reading-text');
          if (continueLink && nextChapter) continueLink.setAttribute('href', nextChapter.getAttribute('href'));
          if (continueText && nextChapter) {
            const number = nextChapter.querySelector('.chapter-badge')?.textContent?.trim() || '01';
            const template = completedCards.length === cards.length
              ? reviewChapterTemplate
              : completedCards.length
                ? continueChapterTemplate
                : startChapterTemplate;
            continueText.textContent = template.replace('{number}', number);
          }
        } catch (_) {
          // Progress is an enhancement; the full course remains usable without local storage.
        }
      }

      setupBookIndex();
      document.addEventListener('astro:after-swap', setupBookIndex);
    })();
  </script>

  <script>
    import { playSoundEffect } from '../../utils/soundEffects.ts';

    function bindBookIndexSounds() {
      document.querySelectorAll<HTMLElement>('[data-chapter-card], #continue-reading-link').forEach((element) => {
        if (element.dataset.bookSoundBound === 'true') return;
        element.dataset.bookSoundBound = 'true';
        element.addEventListener('click', () => playSoundEffect('navigate'));
      });
    }

    bindBookIndexSounds();
    document.addEventListener('astro:after-swap', bindBookIndexSounds);
  </script>
</Layout>
