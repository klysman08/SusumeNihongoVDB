# Generate each key independently, for example: openssl rand -hex 32
ADMIN_API_KEY=replace-with-a-long-random-admin-key
QDRANT_API_KEY=replace-with-a-different-long-random-qdrant-key
QDRANT_DASHBOARD_PORT=6333

# OpenRouter (recommended). Create a key at https://openrouter.ai/settings/keys
# Change only OPENROUTER_MODEL to switch models; model slugs are listed at
# https://openrouter.ai/models. Attribution values are optional.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-a-long-random-admin-key
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-0731
OPENROUTER_TTS_MODEL=x-ai/grok-voice-tts-1.0
OPENROUTER_TTS_JAPANESE_VOICE=ara
OPENROUTER_TTS_ENGLISH_VOICE=ara
OPENROUTER_TTS_PORTUGUESE_VOICE=ara
OPENROUTER_TTS_SPANISH_VOICE=ara
OPENROUTER_TTS_FRENCH_VOICE=ara
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Susume Nihongo

# Used only when LLM_PROVIDER=compatible (for example, a local Ollama gateway).
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=
LLM_API_KEY=

APP_PORT=8080
DENSE_RELEVANCE_FLOOR=0.25
